# probe.cyr — the actual ICMP probe loop.
#
# Ties together: src/platform.cyr (socket I/O + clock + waits), src/icmp.cyr
# (RFC 792 framing + RFC 1071 checksum), src/stats.cyr (RTT accumulator),
# src/output.cyr (per-packet + summary printing).
#
# Exit code matches POSIX ping: 0 if at least one reply, 1 if all
# packets lost, 2 if the socket couldn't even open.

# Set by probe_run when Ctrl-C ended its loop. main stops the run there rather
# than moving on to the next target (audit finding E): the old loop consumed
# the interrupt for one target and carried on with the rest.
var _probe_interrupted = 0;
# 1 when Ctrl-C ended the last probe_run's loop.
fn probe_interrupted(): i64 { return _probe_interrupted; }

# Build a deterministic filler payload of `n` bytes. Sequential 0..255
# wrap pattern — same as iputils-ping. Caller owns the buffer.
fn _probe_fill_payload(buf, n): i64 {
    var i = 0;
    while (i < n) {
        store8(buf + i, i & 0xFF);
        i = i + 1;
    }
    return 0;
}

# Is the n-byte frame at rx the echo reply to probe `seq`? Pure, so the rules
# are unit-tested rather than read off the loop:
#   - at least an ICMP header, of the expected reply type;
#   - seq matches as the 16 bits the wire carries — the counter is an i64, and
#     comparing it whole rejected every reply from probe 65536 on (finding G);
#   - on the SOCK_RAW fallback (`raw` 1) the ident must be ours too: a raw socket
#     sees every echo reply on the host, and yo's ident is random per process,
#     where it used to be a constant shared by every yo (finding A);
#   - `verify` 1 also checks the RFC 1071 checksum. IPv4 raw sockets get their
#     copy before icmp_rcv validates it; ping sockets and IPv6 raw sockets do not.
# On SOCK_DGRAM the kernel has matched the socket's own id, and rewritten ident
# to it, so `raw` is 0 there.
fn probe_reply_is_ours(rx, n, expected_type, seq, ident, raw, verify): i64 {
    if (n < ICMP_HEADER_LEN) { return 0; }
    if (icmp_type(rx) != expected_type) { return 0; }
    if (icmp_seq(rx) != (seq & 0xFFFF)) { return 0; }
    if (raw == 1) {
        if (icmp_ident(rx) != (ident & 0xFFFF)) { return 0; }
    }
    if (verify == 1) {
        if (icmp_verify(rx, n) == 0) { return 0; }
    }
    return 1;
}

# Run the full probe sequence. Returns the process exit code.
# `banner_parens` is a cstr displayed in parentheses on the banner (the
# resolved IP for hostname targets, or the reverse-DNS name for literal
# IPs), or 0 to suppress.
#
# `af` selects address family: 4 → IPv4 (addr_arg is packed u32), 6 →
# IPv6 (addr_arg is a pointer to 16 packed bytes). On v6, the kernel
# fills the ICMPv6 checksum on send and surfaces hop limit via cmsg.
# `scope_id` is the ifindex for link-local v6 destinations (0 for
# global / loopback / v4). Ignored when af == 4.
#
# `diag` (--diag) prints a per-backend first-fail dump on the two ways a
# probe can come back with nothing: the socket never opened, or every
# packet was lost. It is deliberately NOT gated on `quiet` — `-q --diag`
# is the shape you want when scripting a health check, and suppressing
# the reason along with the per-packet chatter would defeat the flag.
#
# Waiting (audit finding E). Each probe waits for a reply with
# platform_wait_readable against an absolute -W deadline, and the gap between
# probes is platform_sleep_interruptible. Both also watch the SIGINT signalfd,
# so Ctrl-C ends the run within a poll wake-up rather than after the current
# wait: SIGINT is blocked for signalfd, so it could interrupt neither the old
# blocking recvmsg (with SO_RCVTIMEO) nor nanosleep — `-i 10000` took 8.5 s to
# notice it. The absolute deadline also bounds a probe at -W: re-arming a full
# SO_RCVTIMEO per non-matching frame let a busy raw socket wait up to ~2×-W.
fn probe_run(target_cstr, af, addr_arg, scope_id, banner_parens,
  count, timeout_ms, interval_ms, size, quiet, diag): i64 {
    _probe_interrupted = 0;
    platform_diag_reset();
    var fd = 0;
    if (af == 6) { fd = platform_icmp6_open(); }
    else         { fd = platform_icmp_open(); }
    if (fd < 0) {
        platform_icmp_open_hint(af);
        if (diag == 1) { platform_diag_dump(target_cstr, af); }
        return 2;
    }
    platform_set_recv_timeout_ms(fd, timeout_ms);

    # alloc(0) is 0 by contract, and -s 0 is a valid probe: give the payload one
    # byte of room so a zero pointer only ever means "out of memory".
    var payload = alloc(size + 1);
    var pkt = alloc(ICMP_HEADER_LEN + size);
    # rx buf: ICMP header + payload + 60 for a maximal IPv4 header on the raw
    # path (it arrives in front of the ICMP message) + 4 slack.
    var rxcap = ICMP_HEADER_LEN + size + 64;
    var rxbuf = alloc(rxcap);
    var ttl_slot = alloc(8);
    if ((payload == 0) || (pkt == 0) || (rxbuf == 0) || (ttl_slot == 0)) {
        var oom = "yo: out of memory\n";
        sys_write(2, oom, strlen(oom));
        platform_close(fd);
        return 2;
    }
    _probe_fill_payload(payload, size);

    # Ident is ours only on the SOCK_RAW fallback (SOCK_DGRAM replaces it with the
    # socket-managed id). Random per process, so two yo processes on raw sockets
    # stop accepting each other's replies (finding A).
    var ident = platform_random_u16();
    var raw = platform_icmp_raw_mode();
    var verify = 0;
    if ((raw == 1) && (af == 4)) { verify = 1; }

    var s = stats_new();
    if (quiet == 0) { output_banner(target_cstr, banner_parens, size); }

    var sigfd = platform_install_interrupt_watch();

    var seq = 0;
    while (seq < count) {
        if (platform_check_interrupted(sigfd) == 1) { _probe_interrupted = 1; break; }

        var pkt_len = 0;
        if (af == 6) { pkt_len = icmp6_build_echo_request(pkt, ident, seq, payload, size); }
        else         { pkt_len = icmp_build_echo_request (pkt, ident, seq, payload, size); }

        var t0 = platform_now_us();
        var sent = 0;
        if (af == 6) { sent = platform_icmp6_send_to(fd, addr_arg, scope_id, pkt, pkt_len); }
        else         { sent = platform_icmp_send_to (fd, addr_arg, pkt, pkt_len); }

        if (sent < 0) {
            # Not a timeout: the packet never left. Say why (finding L).
            stats_record_loss(s);
            if (quiet == 0) { output_send_error(seq, sent); }
        } else {
            # Accept an echo reply for our family, SKIPPING frames that are not
            # one, until the -W deadline.
            #
            # ⛔ THE SKIP IS LOAD-BEARING ON SOCK_RAW, NOT DEFENSIVE. A raw ICMP
            # socket is not demultiplexed by the kernel: it sees every matching
            # frame on the host, INCLUDING yo's own outbound echo request. On
            # loopback that request arrives ahead of the reply, so reading until
            # something matches (or the deadline passes) is what makes the RAW
            # fallback behave like the DGRAM path, where the kernel already did
            # this filtering. On DGRAM the first frame matches and the loop exits
            # immediately, so that path is unchanged.
            var expected_reply = ICMP_ECHO_REPLY;
            if (af == 6) { expected_reply = ICMPV6_ECHO_REPLY; }
            var deadline_us = t0 + timeout_ms * 1000;
            var t1 = t0;
            var got = 0;
            var scanning = 1;
            while (scanning == 1) {
                var left_ms = (deadline_us - platform_now_us() + 999) / 1000;
                if (left_ms <= 0) { scanning = 0; }
                if (scanning == 1) {
                    var w = platform_wait_readable(fd, sigfd, left_ms);
                    if (w == 2) { _probe_interrupted = 1; scanning = 0; }
                    if (w < 0) { scanning = 0; }
                    # w == 0: timed out, or woken for nothing — the loop head
                    # recomputes what is left of -W and ends when it is gone.
                    if (w == 1) {
                        var n = 0;
                        if (af == 6) { n = platform_icmp6_recv_ext(fd, rxbuf, rxcap, ttl_slot); }
                        else         { n = platform_icmp_recv_ext (fd, rxbuf, rxcap, ttl_slot); }
                        t1 = platform_now_us();
                        # A negative return is the timeout / error exit (on AGNOS,
                        # icmp_echo's own timeout arrives here as -11).
                        if (n < 0) { scanning = 0; }
                        if (n >= 0) {
                            if (probe_reply_is_ours(rxbuf, n, expected_reply, seq, ident, raw, verify) == 1) {
                                got = 1;
                                scanning = 0;
                            }
                        }
                    }
                }
            }
            if (got == 1) {
                var rtt = t1 - t0;
                stats_record_reply(s, rtt);
                if (quiet == 0) { output_reply(seq, load64(ttl_slot), rtt); }
            } else {
                stats_record_loss(s);
                if (quiet == 0) {
                    if (_probe_interrupted == 0) { output_timeout(seq); }
                }
            }
        }

        if (_probe_interrupted == 1) { break; }
        seq = seq + 1;
        if (seq < count) {
            if (platform_sleep_interruptible(sigfd, interval_ms) == 1) {
                _probe_interrupted = 1;
                break;
            }
        }
    }

    output_summary(s);
    if (diag == 1) {
        if (stats_recv(s) == 0) { platform_diag_dump(target_cstr, af); }
    }
    platform_close(fd);
    platform_remove_interrupt_watch(sigfd);

    if (stats_recv(s) > 0) { return 0; }
    return 1;
}
