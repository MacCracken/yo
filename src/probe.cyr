# probe.cyr — the actual ICMP probe loop.
#
# Ties together: src/platform.cyr (socket I/O + clock + sleep),
# src/icmp.cyr (RFC 792 framing + RFC 1071 checksum), src/stats.cyr
# (RTT accumulator), src/output.cyr (per-packet + summary printing).
#
# Exit code matches POSIX ping: 0 if at least one reply, 1 if all
# packets lost, 2 if the socket couldn't even open.

# Build a deterministic filler payload of `n` bytes. Sequential 0..255
# wrap pattern — same as iputils-ping. Caller owns the buffer.
fn _probe_fill_payload(buf, n): i64 {
    var i = 0;
    while (i < n) {
        store8(buf + i, i & 0xFF);
        i = i + 1;
    }
    return 0;
}

# Run the full probe sequence. Returns the process exit code.
# `banner_parens` is a cstr displayed in parentheses on the banner (the
# resolved IP for hostname targets, or the reverse-DNS name for literal
# IPs), or 0 to suppress.
#
# `af` selects address family: 4 → IPv4 (addr_arg is packed u32), 6 →
# IPv6 (addr_arg is a pointer to 16 packed bytes). On v6, the kernel
# fills the ICMPv6 checksum on send and surfaces hop limit via cmsg.
# `scope_id` is the ifindex for link-local v6 destinations (0 for
# global / loopback / v4). Ignored when af == 4.
#
# `diag` (--diag) prints a per-backend first-fail dump on the two ways a
# probe can come back with nothing: the socket never opened, or every
# packet was lost. It is deliberately NOT gated on `quiet` — `-q --diag`
# is the shape you want when scripting a health check, and suppressing
# the reason along with the per-packet chatter would defeat the flag.
fn probe_run(target_cstr, af, addr_arg, scope_id, banner_parens, count, timeout_ms, interval_ms, size, quiet, diag): i64 {
    var fd = 0;
    if (af == 6) { fd = platform_icmp6_open(); }
    else         { fd = platform_icmp_open(); }
    if (fd < 0) {
        var msg = "yo: cannot open ICMP socket — try adjusting /proc/sys/net/ipv4/ping_group_range or run with CAP_NET_RAW\n";
        syscall(_LX_SYS_WRITE, 2, msg, strlen(msg));
        if (diag == 1) { platform_diag_dump(target_cstr, af); }
        return 2;
    }
    platform_set_recv_timeout_ms(fd, timeout_ms);

    var payload = alloc(size);
    _probe_fill_payload(payload, size);
    var pkt = alloc(ICMP_HEADER_LEN + size);
    # rx buf: ICMP header + max payload + slack for any IP/extension
    # bytes the kernel might surface even on SOCK_DGRAM (it doesn't,
    # but slack is cheap).
    var rxcap = ICMP_HEADER_LEN + size + 64;
    var rxbuf = alloc(rxcap);

    # Ident is arbitrary on SOCK_DGRAM (kernel rewrites it with the
    # socket-table-managed ID). We still set something deterministic
    # in case the SOCK_RAW fallback is in play, where ident is ours.
    var ident = 0x1234;

    var s = stats_new();
    if (quiet == 0) { output_banner(target_cstr, banner_parens, size); }

    var sigfd = platform_install_interrupt_watch();
    var ttl_slot = alloc(8);

    var seq = 0;
    while (seq < count) {
        if (platform_check_interrupted(sigfd) == 1) { break; }

        var pkt_len = 0;
        if (af == 6) { pkt_len = icmp6_build_echo_request(pkt, ident, seq, payload, size); }
        else         { pkt_len = icmp_build_echo_request (pkt, ident, seq, payload, size); }

        var t0 = platform_now_us();
        var sent = 0;
        if (af == 6) { sent = platform_icmp6_send_to(fd, addr_arg, scope_id, pkt, pkt_len); }
        else         { sent = platform_icmp_send_to (fd, addr_arg, pkt, pkt_len); }

        if (sent < 0) {
            stats_record_loss(s);
            if (quiet == 0) { output_timeout(seq); }
        } else {
            # Accept an echo reply for our family, SKIPPING frames that are not
            # one, until the -W deadline.
            #
            # ⛔ THE SKIP IS LOAD-BEARING ON SOCK_RAW, NOT DEFENSIVE. A raw ICMP
            # socket is not demultiplexed by the kernel: it sees every matching
            # frame on the host, INCLUDING yo's own outbound echo request. On
            # loopback that request arrives ahead of the reply, and the previous
            # single-shot recv spent the probe's one read on it — so the real
            # reply was never read and a live host scored a timeout. Reading until
            # something matches (or the deadline passes) is what makes the RAW
            # fallback behave like the DGRAM path, where the kernel already did
            # this filtering. On DGRAM the first frame matches and the loop exits
            # immediately, so that path is unchanged.
            var expected_reply = ICMP_ECHO_REPLY;
            if (af == 6) { expected_reply = ICMPV6_ECHO_REPLY; }
            var deadline_us = t0 + timeout_ms * 1000;
            var n = 0;
            var t1 = t0;
            var got = 0;
            var scanning = 1;
            while (scanning == 1) {
                if (af == 6) { n = platform_icmp6_recv_ext(fd, rxbuf, rxcap, ttl_slot); }
                else         { n = platform_icmp_recv_ext (fd, rxbuf, rxcap, ttl_slot); }
                t1 = platform_now_us();
                # A short read or a negative return is the timeout / error exit.
                if (n < ICMP_HEADER_LEN) { scanning = 0; }
                if (scanning == 1) {
                    if (icmp_type(rxbuf) == expected_reply) {
                        # `seq` survives on every path: the kernel rewrites ident
                        # on SOCK_DGRAM but never seq, and _ag_icmp_pong echoes
                        # the stored request. Matching it catches a LATE reply
                        # from probe n-1 arriving during probe n, which would
                        # otherwise be timed against the wrong t0 and report a
                        # nonsense RTT.
                        var is_ours = 1;
                        if (icmp_seq(rxbuf) != seq) { is_ours = 0; }
                        # `ident` is only ours on the RAW fallback — SOCK_DGRAM
                        # replaces it with the socket-managed id, so comparing it
                        # there would reject every genuine reply.
                        if (platform_icmp_raw_mode() == 1) {
                            if (icmp_ident(rxbuf) != ident) { is_ours = 0; }
                        }
                        if (is_ours == 1) {
                            got = 1;
                            scanning = 0;
                        }
                    }
                    if (scanning == 1) {
                        # Not ours. Keep reading while -W has budget left.
                        if (t1 >= deadline_us) { scanning = 0; }
                    }
                }
            }
            if (got == 1) {
                var rtt = t1 - t0;
                stats_record_reply(s, rtt);
                if (quiet == 0) { output_reply(seq, load64(ttl_slot), rtt); }
            } else {
                stats_record_loss(s);
                if (quiet == 0) { output_timeout(seq); }
            }
        }

        seq = seq + 1;
        if (seq < count) {
            if (platform_check_interrupted(sigfd) == 1) { break; }
            platform_sleep_ms(interval_ms);
        }
    }

    output_summary(s);
    if (diag == 1) {
        if (stats_recv(s) == 0) { platform_diag_dump(target_cstr, af); }
    }
    platform_close(fd);
    if (sigfd > 0) { platform_close(sigfd); }

    if (stats_recv(s) > 0) { return 0; }
    return 1;
}
