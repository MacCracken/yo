# platform_agnos.cyr — AGNOS backend (sovereign ICMP / UDP / clock).
#
# The agnos breakout (2026-06-14): replaces platform_linux.cyr's POSIX socket()
# path with the AGNOS kernel's sovereign ring-3 syscalls via the
# CYRIUS_TARGET_AGNOS peer (cyrius >= 6.2.6). Same per-backend raw-syscall
# posture as platform_linux.cyr — no POSIX, no lib/net.cyr tagged unions.
#
# THE ICMP MODEL BRIDGE. AGNOS exposes icmp_echo_ex(dst_ip, timeout_ms)#100 — a
# ONE-SHOT primitive that sends an echo request, waits up to timeout_ms for the
# reply, and returns the RTT in ms (or -1 on timeout/no-NIC) in a single blocking
# call. (#55, icmp_echo(dst_ip), is the same call with a fixed ~3 s bound; it is
# the fallback on a kernel older than 1.56.48, which has no #100.) yo's surface is
# POSIX-shaped (open -> send_to -> recv_ext). We collapse it: send_to stores the
# request packet + target; recv_ext calls the echo, then ECHOES THE STORED REQUEST
# BACK as the reply (flip type 8->0, recompute the RFC-1071 checksum via yo's
# icmp_checksum) so yo's parser sees a valid echo-reply matching its own
# id/seq/payload. yo's RTT is measured host-side via platform_now_us across
# send_to..recv_ext, which brackets the blocking echo.
#
# SIGNALS (0.8.0). agnos has no default action for any signal but 9 / 18 / 19
# (agnos-userland-abi.md § 4.9): SIGINT is a pending bit, nothing more. It wakes no
# kernel wait either: neither the echo's wait nor sleep_ms#41 returns early for it
# (only a kill or a stop interrupts those). So the interrupt watch below sees a
# SIGINT between probes and in the sliced interval sleep, never inside a reply
# wait; that wait is bounded by -W instead. And no console key raises SIGINT on
# agnos: Ctrl-C at the console reaches no one. The SIGINT comes from kill#16,
# which only yo's parent, yo itself or init may send.
#
# THE UDP PATH (yo resolves hostnames via DNS): listener-id based + non-blocking,
# identical shape to dig's agnos backend.
#
# Monotonic time + sleep use the cyrius >= 6.2.6 peer wrappers sys_uptime_ms() (#40)
# / sys_sleep_ms() (#41). (0.5.3 called syscall(40)/(41) directly because chrono's
# agnos clock/sleep were stale stubs; 6.2.6 bound chrono + added these wrappers —
# see cyrius issue 2026-06-14-chrono-agnos-monotonic-sleep-stale-stubs.)

var _AG_O_RDONLY      = 0;
var _AG_ICMP_FD       = 900;       # sentinel fd for the (socketless) ICMP path

var _ag_req[256];                  # stored ICMP request (module global = 2048 B)
var _AG_REQ_CAP  = 2048;           # bytes in _ag_req: 256 slots × 8 (module-scope rule)
var _ag_req_len  = 0;
var _ag_req_addr = 0;
var _ag_src_port = 0;              # bound UDP source port (single query at a time)
# The two waits keep separate bounds, as the Linux arm's per-socket SO_RCVTIMEO
# does: -W is the ICMP sentinel's, the DNS timeout the UDP listener's. One shared
# value used to serve both, and it only reached the reply wait because probe_run
# happens to set it after the last lookup.
var _ag_icmp_timeout_ms = 1000;    # -W, for icmp_echo_ex#100
var _ag_udp_timeout_ms  = 5000;    # the DNS poll loop's deadline
var _ag_echo_ex = 0 - 1;           # icmp_echo_ex#100 present? -1 not probed yet, 0 no, 1 yes
var _ag_last_echo_rc  = 0;         # last echo return, for --diag
var _ag_last_echo_arm = 0;         # which echo it was: 100, 55, or 0 = none this target
var _ag_icmp_tx0 = 0;              # net_config#61 ICMP counters when the target began,
var _ag_icmp_rx0 = 0;              #   so --diag reports what moved during this run
var _ag_icmp_to0 = 0;              #   rather than totals since boot
var _ag_icmp_rs0 = 0;

# --- ICMP (one-shot icmp_echo bridge) ---

# No real socket: the sentinel stands in for one.
fn platform_icmp_open(): i64 { return _AG_ICMP_FD; }

# What to tell the user when no ICMP socket opened. On AGNOS that only happens
# for IPv6 — the Linux hint about ping_group_range means nothing here.
fn platform_icmp_open_hint(af): i64 {
    var msg = "yo: no ICMP socket on this backend (agnos has no ICMPv6 syscall)\n";
    if (af != 6) { msg = "yo: cannot reach the agnos ICMP syscall\n"; }
    sys_write(2, msg, strlen(msg));
    return 0;
}

# Forget the previous target's --diag facts (audit finding M), and sample the
# kernel's ICMP counters so the dump can say what moved during this target.
# Four non-blocking reads of net_config#61; -1 on a kernel without them.
fn platform_diag_reset(): i64 {
    _ag_last_echo_rc = 0;
    _ag_last_echo_arm = 0;
    _ag_icmp_tx0 = sys_net_icmp_tx();
    _ag_icmp_rx0 = sys_net_icmp_rx();
    _ag_icmp_to0 = sys_net_icmp_timeouts();
    _ag_icmp_rs0 = sys_net_icmp_replies_sent();
    return 0;
}

# Store the request; the actual send happens inside recv_ext's icmp_echo.
# The request is copied into the 2048-byte _ag_req, so a longer one is refused
# with -EMSGSIZE: it used to be copied whole, and `-s 2041` and up overwrote
# _ag_req_len, then _ag_req_addr (the ping went to the payload's bytes), then
# the DNS globals after them (audit finding D). The kernel's echo (#100 or #55)
# sends its own fixed payload anyway, so -s only shapes the synthesised reply here.
fn platform_icmp_send_to(fd, packed_addr, pkt, pkt_len): i64 {
    if ((pkt_len < 0) || (pkt_len > _AG_REQ_CAP)) { return 0 - 90; }
    _ag_req_addr = packed_addr;
    _ag_req_len  = pkt_len;
    var i = 0;
    while (i < pkt_len) { store8(&_ag_req + i, load8(pkt + i)); i = i + 1; }
    return pkt_len;
}

# Send the stored request and wait for its reply: icmp_echo_ex#100 with -W as
# the bound, or, on a kernel without #100, icmp_echo#55 and its fixed ~3 s.
# Which one is probed once per process (platform_echo_ex_available). Returns
# the kernel's RTT in ms, or -1 on timeout / NIC down.
fn _ag_echo(): i64 {
    if (_ag_echo_ex < 0) { _ag_echo_ex = platform_echo_ex_available(sys_net_icmp_tx()); }
    if (_ag_echo_ex == 1) {
        _ag_last_echo_arm = 100;
        return sys_icmp_echo_ex(_ag_req_addr, platform_echo_timeout_ms(_ag_icmp_timeout_ms));
    }
    _ag_last_echo_arm = 55;
    return sys_icmp_echo(_ag_req_addr);
}

# Do the ping (_ag_echo), then synthesize the echo-reply by handing the stored
# request back with type 8->0 + a recomputed checksum. ttl_out (if non-zero) gets
# a nominal 64 — the echo doesn't surface the reply TTL. Returns reply length, or
# -11 (-EAGAIN, mirrors SO_RCVTIMEO) on timeout.
fn _ag_icmp_pong(buf, maxlen, ttl_out): i64 {
    var rtt = _ag_echo();
    _ag_last_echo_rc = rtt;
    if (rtt < 0) { return 0 - 11; }
    var n = _ag_req_len;
    if (n > maxlen) { n = maxlen; }
    var i = 0;
    while (i < n) { store8(buf + i, load8(&_ag_req + i)); i = i + 1; }
    store8(buf, ICMP_ECHO_REPLY);              # type 8 -> 0
    store8(buf + 2, 0); store8(buf + 3, 0);    # zero cksum before recompute
    var ck = icmp_checksum(buf, n);            # yo's RFC 1071 checksum
    store8(buf + 2, (ck >> 8) & 0xFF);
    store8(buf + 3, ck & 0xFF);
    if (ttl_out != 0) { store64(ttl_out, 64); }
    return n;
}

# Plain recv: the echo bridge without a TTL out.
fn platform_icmp_recv(fd, buf, maxlen): i64 { return _ag_icmp_pong(buf, maxlen, 0); }
# Run the echo (#100, or #55) and hand back the synthesised reply; TTL out is a nominal 64.
fn platform_icmp_recv_ext(fd, buf, maxlen, ttl_out): i64 { return _ag_icmp_pong(buf, maxlen, ttl_out); }

# --- UDP (DNS resolution) ---

var _ag_peer_ip   = 0;             # UDP peer recorded by platform_udp_send_to
var _ag_peer_port = 0;             # 0 = nothing sent yet (accept any sender)

# A 16-bit random value: the DNS query ID and the UDP source port. getrandom#45
# failing used to leave the port to whatever was on the stack (audit finding R);
# now it degrades to the clock, predictably but defined.
fn platform_random_u16(): i64 {
    var rb[8];
    if (sys_getrandom(&rb, 2, 0) == 2) {
        return ((load8(&rb) << 8) | load8(&rb + 1)) & 0xFFFF;
    }
    return (sys_uptime_ms() * 7919) & 0xFFFF;
}

# Bind a UDP listener on a random port in 49152..65535 (udp_bind#51).
fn platform_udp_open(): i64 {
    var port = 49152 + (platform_random_u16() & 0x3FFF);
    var lid = sys_udp_bind(port);
    if (lid < 0) { return lid; }
    _ag_src_port = port;
    _ag_peer_ip = 0;
    _ag_peer_port = 0;
    return lid;
}

# Records the peer, so platform_udp_recv can drop datagrams from anyone else —
# the AGNOS kernel delivers to a listener by destination port alone.
fn platform_udp_send_to(fd, packed_addr, port, pkt, pkt_len): i64 {
    _ag_peer_ip = packed_addr;
    _ag_peer_port = port & 0xFFFF;
    var packed_ports = (_ag_src_port << 16) | _ag_peer_port;
    return sys_udp_send(packed_addr, packed_ports, pkt, pkt_len);
}

# Poll the non-blocking udp_recv#53 against the timeout. A datagram whose source
# (the kernel's 16-byte `from` record) is not the recorded peer is dropped and
# the wait continues (audit finding K; the layout is platform_peer_match's).
# Polls at least once. Returns bytes, a kernel error, or -11 (-EAGAIN) on expiry.
fn platform_udp_recv(fd, buf, maxlen): i64 {
    var deadline = sys_uptime_ms() + _ag_udp_timeout_ms;
    var from[16];
    while (1) {
        store64(&from, 0);
        store64(&from + 8, 0);
        var n = sys_udp_recv(fd, buf, maxlen, &from);
        if (n < 0) { return n; }
        if (n > 0) {
            if (platform_peer_match(&from, _ag_peer_ip, _ag_peer_port) == 1) { return n; }
        }
        if (sys_uptime_ms() >= deadline) { return 0 - 11; }
        sys_sleep_ms(5);
    }
    return 0 - 11;
}

# --- common ---

# Release a UDP listener; the ICMP sentinel has nothing to close.
fn platform_close(fd): i64 {
    if (fd >= _AG_ICMP_FD) { return 0; }       # ICMP sentinel — nothing to close
    return sys_udp_unbind(fd);                 # else a UDP listener
}

# Record a reply-wait bound for `fd`: on the ICMP sentinel it is -W, which
# icmp_echo_ex#100 enforces in the kernel; on a UDP listener it is the DNS poll
# loop's deadline. Per fd, as SO_RCVTIMEO is on Linux.
fn platform_set_recv_timeout_ms(fd, timeout_ms): i64 {
    if (fd >= _AG_ICMP_FD) {
        _ag_icmp_timeout_ms = timeout_ms;
        return 0;
    }
    _ag_udp_timeout_ms = timeout_ms;
    return 0;
}

# Read up to maxlen bytes of a file (sys_open / sys_read / sys_close).
fn platform_read_file(path, buf, maxlen): i64 {
    var nl = 0;
    while (load8(path + nl) != 0) { nl = nl + 1; }
    var fd = sys_open(path, nl, _AG_O_RDONLY);
    if (fd < 0) { return fd; }
    var n = sys_read(fd, buf, maxlen);
    sys_close(fd);
    return n;
}

# AGNOS net_config(field=3) → the DHCP-leased DNS resolver (option 6, else the
# leased gateway), packed first-octet-high-byte; 0 if unconfigured. _dns_choose_
# nameserver prefers this over /etc/resolv.conf + the off-subnet 1.1.1.1 fallback:
# the leased resolver is on-subnet, so it routes without depending on gateway-MAC
# egress — the QEMU-passed / iron-failed gap for `yo google.com`.
#
# 0.5.7 shipped this as a raw `syscall(61, 3)` because cyrius had no wrapper
# (issue 2026-06-23-agnos-net-config-syscall-wrapper). 6.5.35 ships one, so the
# literal is gone — the last raw syscall number in yo's AGNOS backend. The agnos
# syscall lib spells out why that matters: #61 is net_config on AGNOS but
# wait4(2) on Linux. The #ifdef kept us safe, but a number that means two
# different things on two kernels does not belong in a source file.
fn platform_dns_server(): i64 { return sys_net_dns_server(); }

# Monotonic time, us — uptime_ms#40 × 1000, so 1 ms resolution.
fn platform_now_us(): i64 { return sys_uptime_ms() * 1000; }

# Sleep for ms milliseconds (sleep_ms#41).
fn platform_sleep_ms(ms): i64 {
    if (ms <= 0) { return 0; }
    return sys_sleep_ms(ms);
}

# --- not supported on AGNOS (stubs) ---

# No IPv6 ICMP syscall on AGNOS — report unavailable so yo skips the v6 path.
fn platform_icmp6_open(): i64 { return 0 - 1; }
# No ICMPv6 on agnos: always -1.
fn platform_icmp6_send_to(fd, addr16, scope_id, pkt, pkt_len): i64 { return 0 - 1; }
# No ICMPv6 on agnos: always -1.
fn platform_icmp6_recv_ext(fd, buf, maxlen, hop_out): i64 { return 0 - 1; }

# No interface-index / netlink concept exposed to ring 3 — 0 = unscoped/default.
# No raw-socket concept on AGNOS — the kernel echo matches the reply in-kernel
# (by id and sequence) and _ag_icmp_pong synthesises it locally, so there is
# never a foreign frame to filter out.
fn platform_icmp_raw_mode(): i64 { return 0; }

# No interface indexes in ring 3: always 0 (unscoped).
fn platform_resolve_ifindex(name): i64 { return 0; }

# --- the interrupt watch (SIGINT through signalfd#18) -----------------

var _ag_sigmask[1];                # 8 B: the SIGINT set for sigprocmask#17 / signalfd#18
var _ag_sigrec[1];                 # 8 B: one signalfd record (the kernel writes a u32 signo)

# The SIGINT set, built by the stdlib's agnos sigset_add. ⚠ agnos sets are
# `1 << sig` (bit 2 for SIGINT), not Linux's `1 << (sig - 1)`; the agnos peer's
# sigset_add encodes that, so the bit is never spelled out here.
fn _ag_sigint_set(): i64 {
    store64(&_ag_sigmask, 0);
    sigset_add(&_ag_sigmask, SIGINT);
    return &_ag_sigmask;
}

# Watch for SIGINT: block it (sigprocmask#17), then open a signalfd#18 on it,
# the shape agnos-userland-abi.md § 4.9 gives. The block changes no delivery
# (SIGINT has no default action on agnos to suppress); it keeps a future
# epoll_wait#21 from answering -4 for a signal this watch consumes. Returns the
# signalfd, or -1, with the mask restored when the signalfd cannot be had.
fn platform_install_interrupt_watch(): i64 {
    var set = _ag_sigint_set();
    if (sys_sigprocmask(SIG_BLOCK, set, 0) < 0) { return 0 - 1; }
    var fd = sys_signalfd(0 - 1, set, SFD_NONBLOCK);
    if (fd < 0) {
        sys_sigprocmask(SIG_UNBLOCK, set, 0);
        return 0 - 1;
    }
    return fd;
}

# Undo platform_install_interrupt_watch: close the signalfd and unblock SIGINT.
# A SIGINT that lands after this stays pending, and the next target's watch
# reads it at its first check, so it still stops the run there.
fn platform_remove_interrupt_watch(sigfd): i64 {
    if (sigfd < 0) { return 0; }
    sys_close(sigfd);
    sys_sigprocmask(SIG_UNBLOCK, _ag_sigint_set(), 0);
    return 0;
}

# Non-blocking: 1 if a SIGINT was pending (the read consumes it), else 0. A
# signalfd read never waits on agnos (it answers 4 bytes or 0), and
# sys_read_nb says so anyway. A negative fd (no watch) is never interrupted.
fn platform_check_interrupted(fd): i64 {
    if (fd < 0) { return 0; }
    if (sys_read_nb(fd, &_ag_sigrec, 8) > 0) { return 1; }
    return 0;
}

# There is nothing to wait on: the echo blocks inside recv_ext, so the "socket"
# is always ready to be read. ⚠ That wait cannot be interrupted. A SIGINT does
# not end it; only kill 9 does. So it runs to the reply or to -W, and the
# signal is seen by the check that follows: the interval sleep, the next
# probe's check, or the post-loop check in probe_run.
fn platform_wait_readable(fd, sigfd, timeout_ms): i64 { return 1; }

# Sleep for ms milliseconds unless SIGINT arrives first: 1 when interrupted
# (the signal is consumed), else 0. A signal wakes no sleep_ms#41 on agnos, so
# the sleep runs in slices of at most PLATFORM_SLEEP_SLICE_MS against an
# absolute deadline, checking the signalfd before each slice and once more at
# the end. A SIGINT is therefore seen within one slice plus a timer tick, and
# the slices do not add up to more than the interval. Without a watch
# (sigfd < 0) it is a plain sleep.
fn platform_sleep_interruptible(sigfd, ms): i64 {
    if (ms <= 0) { return platform_check_interrupted(sigfd); }
    if (sigfd < 0) { platform_sleep_ms(ms); return 0; }
    var deadline = sys_uptime_ms() + ms;
    while (1) {
        if (platform_check_interrupted(sigfd) == 1) { return 1; }
        var left = deadline - sys_uptime_ms();
        if (left <= 0) { return 0; }
        sys_sleep_ms(platform_sleep_slice_ms(left));
    }
    return 0;
}

# --- first-fail diagnostics (--diag) ----------------------------------
#
# The AGNOS counterpart of platform_linux.cyr's dump, and the reason the
# flag exists at all: on agnos there is no `ip addr`, no `dmesg`, no
# second terminal. When a probe returns nothing on iron you have the
# serial console and whatever the tool prints, so the tool has to print
# the network state itself.
#
# net_config#61 is the whole story. All four fields are populated by the
# DHCP ACK (net_dhcp.cyr), so an unset `net ip` means no lease was ever
# taken — the NIC never came up, or the DISCOVER/OFFER never completed.
# That single line separates "yo is broken" from "the box has no network",
# which is the first fork in every AGNOS net debug.
#
# The second fork is the ICMP counters, net_config#61 fields 4..7 (agnos
# 1.56.48): did an echo request leave this host at all? tx moving with rx
# still is the network or the target; tx not moving is a local fault. They
# are kernel-wide and count from boot, so the dump prints how far each moved
# during this target (sampled at platform_diag_reset) beside its total. A
# second process pinging at the same time moves them too; the verdict names
# that case when it can see it (rx moved, but yo got nothing).
fn platform_diag_dump(target, af): i64 {
    output_diag_open(target, af);
    output_diag_kv("backend         ", "agnos (sovereign syscalls)");

    if (af == 6) {
        output_diag_kv("note            ",
            "no ICMPv6 syscall on agnos — the v6 path is unavailable, not merely silent");
    }

    output_diag_kv_ipv4("net ip          ", sys_net_ip());
    output_diag_kv_ipv4("netmask         ", sys_net_netmask());
    output_diag_kv_ipv4("gateway         ", sys_net_gateway());
    output_diag_kv_ipv4("dns server      ", sys_net_dns_server());

    if (sys_net_ip() == 0) {
        output_diag_kv("diagnosis       ", "no DHCP lease — the NIC never configured; nothing could have been sent");
    }

    if (af != 6) { _ag_diag_echo(); }
    return 0;
}

# The --diag lines for the last echo and the ICMP counters (IPv4 only: the v6
# path never reaches the kernel).
fn _ag_diag_echo(): i64 {
    # The echo returns RTT in ms (>= 0) or -1 on timeout / NIC down.
    if (_ag_last_echo_arm == 0) {
        output_diag_kv("icmp echo       ",
            "not called (no request reached the kernel: every send was refused, or the run ended first)");
    }
    if (_ag_last_echo_arm == 100) {
        output_diag_kv_int("echo timeout ms ", platform_echo_timeout_ms(_ag_icmp_timeout_ms));
        if (_ag_last_echo_rc < 0) {
            output_diag_kv("icmp_echo_ex#100", "-1 (no reply within the timeout above, or NIC down)");
        }
        if (_ag_last_echo_rc >= 0) { output_diag_kv_int("icmp_echo_ex#100", _ag_last_echo_rc); }
    }
    if (_ag_last_echo_arm == 55) {
        output_diag_kv("note            ",
            "this kernel has no icmp_echo_ex#100 (agnos < 1.56.48), so -W was not applied");
        if (_ag_last_echo_rc < 0) {
            output_diag_kv("icmp_echo #55   ", "-1 (timed out at the kernel's fixed ~3 s bound, or NIC down)");
        }
        if (_ag_last_echo_rc >= 0) { output_diag_kv_int("icmp_echo #55   ", _ag_last_echo_rc); }
    }

    var tx = sys_net_icmp_tx();
    var rx = sys_net_icmp_rx();
    var v = platform_icmp_verdict(_ag_icmp_tx0, tx, _ag_icmp_rx0, rx);
    if (v == PLATFORM_ICMP_UNKNOWN) {
        output_diag_kv("icmp counters   ", "unavailable (agnos < 1.56.48 has none)");
        return 0;
    }
    # Fields 4..7 arrived together, so known tx/rx means known timeouts too.
    output_diag_kv_counter("icmp tx         ", _ag_icmp_tx0, tx);
    output_diag_kv_counter("icmp rx         ", _ag_icmp_rx0, rx);
    output_diag_kv_counter("icmp timeouts   ", _ag_icmp_to0, sys_net_icmp_timeouts());
    output_diag_kv_counter("pings answered  ", _ag_icmp_rs0, sys_net_icmp_replies_sent());
    if (v == PLATFORM_ICMP_NONE_SENT) {
        output_diag_kv("verdict         ",
            "no echo request left this host: a local fault (NIC down, no route, send failed), not the network");
    }
    if (v == PLATFORM_ICMP_NO_REPLY) {
        output_diag_kv("verdict         ",
            "requests left this host and no reply matched: the path or the target dropped them");
    }
    if (v == PLATFORM_ICMP_OTHER_REPLY) {
        output_diag_kv("verdict         ",
            "the kernel matched replies, none of them yo's: another process was pinging; re-run alone");
    }
    return 0;
}
