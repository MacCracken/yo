# platform.cyr — platform dispatch shim.
#
# TWO backends ship, and this #ifdef is the only seam between them. Each defines
# the same 27-function platform_* surface; probe.cyr and dns.cyr call that surface
# and never learn which one they got.
#
#   src/platform_linux.cyr   POSIX sockets, reached by raw syscall number (no
#                            libc). Unprivileged AF_INET SOCK_DGRAM ICMP with a
#                            SOCK_RAW fallback.
#   src/platform_agnos.cyr   No POSIX. Sovereign ring-3 agnos syscalls —
#                            icmp_echo(#55), udp_bind/send/recv/unbind (#51-54),
#                            net_config(#61), getrandom(#45), uptime/sleep
#                            (#40/#41). Landed 0.5.3; iron-validated on the agnos
#                            1.51.7 burn; gated in CI by `cyrius build --agnos`
#                            and locally by scripts/agnos-qemu-smoke.sh.
#
# The two are NOT at feature parity, and that is deliberate rather than unfinished
# — the AGNOS arm stubs what the kernel does not expose (ICMPv6, ifindex, signal
# infra) and cannot honour -W. See docs/adr/0001-per-backend-sovereignty.md for
# the rule and docs/adr/0002-focused-kernel-icmp-syscall.md for the costs.
#
# Windows / macOS are post-1.0 (roadmap.md § v1 backlog). They are host kernels, so
# they inherit the pragmatic Linux treatment when they arrive; the sovereignty
# rule only bites on AGNOS.
#
# Pure helpers that one backend needs and the host test build must reach live
# above the #ifdef, so tests/yo.tcyr (always a Linux build) can exercise them.

# Did a datagram come from the peer we sent to? `from` is the 16-byte record the
# AGNOS udp_recv#53 kernel fills: source ip at +0 (packed, first octet high, as
# ipv4_parse packs it) and source port at +8 — the layout taar 0.6.2 confirmed
# in the agnos kernel source (net_ingress.cyr, net.cyr). The kernel delivers a
# datagram by destination port alone, so without this check anyone who guesses
# the port can answer a DNS query (audit finding K). A zero `peer_port` means
# nothing has been sent yet and accepts any sender. 1 = accept, 0 = drop.
fn platform_peer_match(from, peer_ip, peer_port): i64 {
    if (peer_port == 0) { return 1; }
    if (load64(from) != peer_ip) { return 0; }
    if (load64(from + 8) != peer_port) { return 0; }
    return 1;
}

#ifdef CYRIUS_TARGET_AGNOS
include "src/platform_agnos.cyr"
#endif
#ifndef CYRIUS_TARGET_AGNOS
include "src/platform_linux.cyr"
#endif
