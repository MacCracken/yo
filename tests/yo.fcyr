# yo fuzz harness

fn fuzz_main(data, len) {
    if (len == 0) { return 0; }
    return 0;
}

fn main() {
    alloc_init();
    fuzz_main("test", 4);
    println("fuzz: ok");
    return 0;
}

var r = main();
# Clamp before exiting: a wait status is only 8 bits, so any exit code that is
# a multiple of 256 truncates to 0 and would score PASS. Any failure at all is
# exit 1.
if (r > 0) { r = 1; }
sys_exit_group(r);
