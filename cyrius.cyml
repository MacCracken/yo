[package]
name = "yo"
version = "0.5.7"
description = "yo — Yodel-Out, ICMP echo probe (Cyrius-native sovereign ping)"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.2.24"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "yo"

[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert", "bench", "args", "flags"]

# Network-probe substrate — the IPv4 codec yo shared byte-identically
# with dig, extracted at the yo-0.5.5 / dig-0.3.3 fold. taar 0.3.1 adds
# the AGNOS kernel-leased-resolver path (`net_config`#61); yo's own DNS
# uses it via `platform_dns_server`, and still consumes taar only for the
# pure IPv4 codec. `path` drives local dev resolution; `git`+`tag` is the
# published fallback.
[deps.taar]
git = "https://github.com/MacCracken/taar.git"
path = "../taar"
tag = "0.3.1"
modules = ["dist/taar.cyr"]
---
