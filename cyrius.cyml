[package]
name = "yo"
version = "${file:VERSION}"
description = "yo — Yodel-Out, ICMP echo probe (Cyrius-native sovereign ping)"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.5.35"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "yo"

[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert", "bench", "args", "flags"]

# Network-probe substrate — the IPv4 codec yo shared byte-identically
# with dig, extracted at the yo-0.5.5 / dig-0.3.3 fold. yo consumes taar
# for the pure IPv4 codec only (`ipv4_parse`); the socket/dns modules ride
# along in the bundle and DCE out. taar 0.5.0's changes are all in that
# unused half (AGNOS `taar_tcp_recv` recv-contract parity, DNS TCP
# fallback), so the `ipv4_*` surface is unchanged from 0.3.1. yo's own DNS
# still reaches the AGNOS kernel-leased resolver (`net_config`#61) through
# its own `platform_dns_server`, not through taar. `path` drives local dev
# resolution; `git`+`tag` is the published fallback.
[deps.taar]
git = "https://github.com/MacCracken/taar.git"
path = "../taar"
tag = "0.5.0"
modules = ["dist/taar.cyr"]
---
