[package]
name = "yo"
version = "${file:VERSION}"
description = "yo — Yodel-Out, ICMP echo probe (Cyrius-native sovereign ping)"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "yo"

[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert", "bench", "args", "flags"]

# Network-probe substrate — the IPv4 codec yo shared byte-identically
# with dig, extracted at the yo-0.5.5 / dig-0.3.3 fold. yo consumes taar
# for the pure IPv4 codec only (`ipv4_parse`); the socket/dns modules ride
# along in the bundle and DCE out. taar 0.6.2 is on cyrius 6.7.18; its
# changes since 0.6.0 (an audit release) are all in that unused half, and
# the bundle's ipv4 section is byte-identical, so the `ipv4_*` surface is
# unchanged from 0.3.1. yo's own DNS still reaches the AGNOS
# kernel-leased resolver (`net_config`#61) through its own
# `platform_dns_server`, not through taar. `git`+`tag` is what every default
# resolve builds, commit-pinned in cyrius.lock (cyrius >= 6.7.6). `path` is a
# dev override, read only in local mode (`CYRIUS_LOCAL=1`, `--local`).
[deps.taar]
git = "https://github.com/MacCracken/taar.git"
path = "../taar"
tag = "0.6.2"
modules = ["dist/taar.cyr"]
---
